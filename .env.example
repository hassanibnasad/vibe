# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=vibeagent
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=dev-secret-key-change-in-production-min-32-chars

# ── Database (PostgreSQL 16 + pgvector) ──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://vibeagent:vibeagent@localhost:5432/vibeagent
DATABASE_POOL_SIZE=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Default: Groq cloud (free tier, ~500 tok/s, no GPU required).
# Override LLM_MODEL_PRIMARY / LLM_MODEL_FAST to switch providers.
#
# Groq (recommended — fastest free-tier cloud inference)
GROQ_API_KEY=           # get free key at https://console.groq.com
LLM_MODEL_PRIMARY=groq/llama-3.3-70b-versatile
LLM_MODEL_FAST=groq/llama-3.1-8b-instant

# Google Gemini (optional alternative — free up to 1M tok/day)
GEMINI_API_KEY=         # get key at https://ai.google.dev/
# LLM_MODEL_PRIMARY=gemini/gemini-2.0-flash
# LLM_MODEL_FAST=gemini/gemini-2.0-flash-lite

# DeepSeek (optional alternative — $0.07/1M input tokens)
DEEPSEEK_API_KEY=       # get key at https://platform.deepseek.com
# LLM_MODEL_PRIMARY=deepseek/deepseek-chat

# OpenRouter (optional — pay-per-use, widest model selection)
OPENROUTER_API_KEY=

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Local Ollama (fallback for offline / no-key development)
OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL_PRIMARY=ollama/llama3.1:70b
# LLM_MODEL_FAST=ollama/llama3.1:8b

# ── LiteLLM Proxy (optional — for shared team gateway) ───────────────────────
LITELLM_PROXY_URL=
LITELLM_API_KEY=

# ── Image Generation ─────────────────────────────────────────────────────────
# Provider: "huggingface" (Flux-Schnell HF Space) | "together" | "pollinations" (zero-key fallback) | "" (disabled)
IMAGE_GEN_PROVIDER=huggingface
IMAGE_GEN_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_GEN_SPACE_ID=black-forest-labs/FLUX.1-schnell
IMAGE_GEN_SPACE_URL=https://huggingface.co/spaces/black-forest-labs/FLUX.1-schnell
IMAGE_GEN_WIDTH=1024
IMAGE_GEN_HEIGHT=1024
IMAGE_GEN_STEPS=4
# Hugging Face Access Token (optional for public Spaces, recommended for dedicated ZeroGPU quota)
HF_TOKEN=                 # get token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
# Together AI key (alternative provider)
TOGETHER_API_KEY=         # get free key at https://api.together.xyz

# ── Embedding Service ─────────────────────────────────────────────────────────
# Backend: "fastembed" (in-process ONNX, $0 cost) or "litellm" (Ollama/OpenAI/etc.)
EMBEDDING_BACKEND=fastembed
# Model for FastEmbed (ignored when EMBEDDING_BACKEND=litellm)
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# MUST match the Vector(N) column in knowledge_docs table
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_ENABLED=true
# Embedding cache TTL in seconds (604800 = 7 days)
EMBEDDING_CACHE_TTL=604800

# ── Brand Extraction / Vision ─────────────────────────────────────────────────
# Leave empty to skip screenshot analysis; set to a vision-capable model to enable.
# Examples: "gemini/gemini-2.0-flash", "openai/gpt-4o", "together_ai/meta-llama/Llama-Vision-Free"
VISION_LLM_MODEL=gemini/gemini-2.0-flash

# ── Agent Thresholds ──────────────────────────────────────────────────────────
REPLY_CONFIDENCE_THRESHOLD=0.75
MAX_RETRIES=3

# ── Hatchet Workflow Engine ───────────────────────────────────────────────────
# HATCHET_CLIENT_TOKEN: API token from the Hatchet dashboard.
#   - Hatchet Cloud: sign up at https://cloud.hatchet.run, go to Settings → API Tokens.
#   - Self-hosted: generate via `hatchet-admin token create` or the admin dashboard.
HATCHET_CLIENT_TOKEN=

# HATCHET_HOST: gRPC host:port for the Hatchet engine.
#   - Hatchet Cloud: leave empty (SDK uses the cloud endpoint automatically).
#   - Self-hosted (local Docker): localhost:7077
#   - Self-hosted (Docker network): hatchet-engine:7077
HATCHET_HOST=

# ── Authentik (Auth/IAM) ──────────────────────────────────────────────────────
AUTHENTIK_BASE_URL=http://localhost:9000
AUTHENTIK_CLIENT_ID=vibeagent
AUTHENTIK_CLIENT_SECRET=

# ── RustFS / MinIO Object Storage ─────────────────────────────────────────────
RUSTFS_ENDPOINT=http://localhost:9001
RUSTFS_ACCESS_KEY=minioadmin
RUSTFS_SECRET_KEY=minioadmin
RUSTFS_BUCKET=vibeagent-media

# ── LinkedIn Connector ────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/connectors/linkedin/callback
# LINKEDIN_API_VERSION and legacy LINKEDIN_ACCESS_TOKEN/ORGANIZATION_ID are
# kept for backward compatibility only; new publishing uses SocialConnection.
LINKEDIN_API_VERSION=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=

# Fernet key for encrypting stored OAuth tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# URL the backend redirects the browser to after OAuth callback
FRONTEND_BASE_URL=http://localhost:3000

# ── Webhooks ──────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=dev-webhook-secret

# ── Monitoring & Logging ──────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Misc provider keys (optional) ────────────────────────────────────────────
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
ANTHROPIC_API_KEY=
