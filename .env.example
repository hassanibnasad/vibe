# ── Application ──
APP_NAME=vibeagent
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=dev-secret-key-change-in-production-min-32-chars

# ── Database (PostgreSQL 16 + pgvector) ──
DATABASE_URL=postgresql+asyncpg://vibeagent:vibeagent@localhost:5432/vibeagent
DATABASE_POOL_SIZE=20

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Ollama LLM ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_PRIMARY=llama3.1:70b
OLLAMA_MODEL_FAST=llama3.1:8b
OLLAMA_EMBED_MODEL=all-minilm:l6-v2

# ── Agent Thresholds ──
REPLY_CONFIDENCE_THRESHOLD=0.75
MAX_RETRIES=3

# ── Hatchet Workflow Engine ──
HATCHET_CLIENT_TOKEN=
HATCHET_HOST=localhost:7077

# ── Authentik (Auth/IAM) ──
AUTHENTIK_BASE_URL=http://localhost:9000
AUTHENTIK_CLIENT_ID=vibeagent
AUTHENTIK_CLIENT_SECRET=

# ── RustFS Object Storage ──
RUSTFS_ENDPOINT=http://localhost:9001
RUSTFS_ACCESS_KEY=minioadmin
RUSTFS_SECRET_KEY=minioadmin
RUSTFS_BUCKET=vibeagent-media

# ── Platform API Keys (Optional per platform) ──
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=

# ── Webhooks ──
WEBHOOK_SECRET=dev-webhook-secret

# ── Monitoring & Logging ──
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json
